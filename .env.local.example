# Copy to .env.local and adjust for your environment.
#
# Base URL of the backend API — no trailing slash, no /api suffix.
# REST calls append /api themselves; Socket.IO connects to this origin's
# /chat and /notifications namespaces directly (the backend's global "/api"
# HTTP prefix does not apply to WebSocket namespaces).
#
# When switching to a deployed backend, this is the ONLY value that needs to
# change — nothing in the app code hardcodes an endpoint.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
